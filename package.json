{
  "name": "myndssale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mynds e-commerce storefront + admin",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next start",
    "lint": "tsc --noEmit",
    "import:products": "node --disable-warning=ExperimentalWarning scripts/import-products.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
