# ---- Required in production ----
# รหัสผ่านเข้าหลังบ้าน /admin (ตั้งให้ยาวและเดายาก)
ADMIN_PASSWORD=change-me
# คีย์สำหรับเซ็น cookie หลังบ้าน (สุ่มยาว ๆ เช่น `openssl rand -hex 32`)
SESSION_SECRET=
# URL จริงของเว็บ ใช้ทำ sitemap / canonical
NEXT_PUBLIC_SITE_URL=https://mynds.co

# ---- Optional ----
# ตำแหน่งไฟล์ฐานข้อมูล SQLite (ค่าเริ่มต้น ./data/mynds.db) — บน Railway ให้ชี้ไปที่ volume
DATABASE_PATH=
# Tracking (โหลดหลังลูกค้ากดยอมรับคุกกี้เท่านั้น)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# แจ้งเตือนออเดอร์ใหม่เข้า LINE OA (Messaging API) — userId หรือ groupId ของทีม
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=
# ---- JST (ซิงก์สต็อกอัตโนมัติ) — ได้จาก JST / ดูหลังบ้าน › ซิงก์สต็อก JST ----
JST_APP_KEY=
JST_APP_SECRET=
JST_ACCESS_TOKEN=
# ปรับได้ถ้าเอกสารของ JST ระบุต่างจากค่าเริ่มต้น
JST_API_BASE=https://openapi.jushuitan.com
JST_INVENTORY_PATH=/open/inventory/query
# รหัสคลัง (ถ้า JST ให้ระบุ) — เว้นว่าง = รวมทุกคลัง
JST_WMS_CO_ID=
# ซิงก์ทุกกี่นาที (0 = ปิดอัตโนมัติ, กดซิงก์เองได้ในหลังบ้าน)
JST_SYNC_MINUTES=10
