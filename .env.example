# ---- Required in production ----
# รหัสผ่านเข้าหลังบ้าน /admin (ตั้งให้ยาวและเดายาก)
ADMIN_PASSWORD=change-me
# คีย์สำหรับเซ็น cookie หลังบ้าน (สุ่มยาว ๆ เช่น `openssl rand -hex 32`)
SESSION_SECRET=
# URL จริงของเว็บ ใช้ทำ sitemap / canonical
NEXT_PUBLIC_SITE_URL=https://mynds.co

# ---- Optional ----
# ตำแหน่งไฟล์ฐานข้อมูล SQLite (ค่าเริ่มต้น ./data/mynds.db) — บน Railway ให้ชี้ไปที่ volume
DATABASE_PATH=
# Tracking (โหลดหลังลูกค้ากดยอมรับคุกกี้เท่านั้น)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# แจ้งเตือนออเดอร์ใหม่เข้า LINE OA (Messaging API) — userId หรือ groupId ของทีม
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=
